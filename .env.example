DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=root
DATABASE_NAME=pdp-api

# Auth (required). JWT_ACCESS_SECRET must be at least 32 characters.
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=pdp-api
JWT_AUDIENCE=pdp-client
JWT_ACCESS_EXPIRES_IN=900
REFRESH_TOKEN_TTL_DAYS=7

# Cookie flags. Use COOKIE_SAMESITE=none and COOKIE_SECURE=true (HTTPS)
# when the SPA is on a different site than the API.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Comma-separated browser origins allowed to send the refresh cookie.
CORS_ORIGINS=http://localhost:3000
